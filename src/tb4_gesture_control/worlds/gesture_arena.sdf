<?xml version="1.0"?>
<!--
  Sân demo điều khiển bằng cử chỉ: mặt phẳng trống, tường bao 8 x 8 m (cao 0.5 m để LiDAR ~19 cm thấy được).
  Robot spawn ở gốc tọa độ (dock nằm ngay trước mặt, +x), mọi phía còn trống >= 3.8 m:
  đủ cho tiến-lùi 0.4 m, vòng tròn bán kính 0.5 m và xoay tại chỗ mà không chạm tường.
-->
<sdf version="1.8">
  <world name="gesture_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact" filename="ignition-gazebo-contact-system"/>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vòng tròn đánh dấu vùng hoạt động, chỉ để nhìn. Sau prepare_robot (undock + tiến 0.6 m)
         robot đứng ở x ~ -0.95, quay về -x; mọi hành vi nằm trong bán kính ~1.3 m quanh (-1.3, 0) -->
    <model name="work_area_marker">
      <static>true</static>
      <pose>-1.3 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>1.3</radius><length>0.001</length></cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.75 0.95 1</ambient>
            <diffuse>0.55 0.75 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="arena_walls">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="north">
        <pose>4.05 0 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="south">
        <pose>-4.05 0 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="east">
        <pose>0 -4.05 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
      <link name="west">
        <pose>0 4.05 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2 0.1 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
