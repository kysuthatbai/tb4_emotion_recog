        <geometry><cylinder><radius>0.09</radius><length>0.52</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.02 0.02 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>
      </visual>
      <visual name="shoulder">
