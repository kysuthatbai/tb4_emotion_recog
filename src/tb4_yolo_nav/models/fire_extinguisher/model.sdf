<?xml version="1.0"?>
<!-- Bình chữa cháy ~0.68 m: thân đỏ, đáy đen, nhãn trắng phía trước (+x), van/tay cầm kim loại, vòi đen phía sau. -->
<sdf version="1.8">
  <model name="fire_extinguisher">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.34 0 0 0</pose>
        <geometry><cylinder><radius>0.1</radius><length>0.68</length></cylinder></geometry>
      </collision>

      <visual name="base">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.095</radius><length>0.024</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="body">
